# Secret key para Flask (OBLIGATORIA, sin ella la app no arranca)
# Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=clave-segura-cambiar-en-produccion

# Origenes permitidos para WebSockets (opcional)
# Por defecto solo se acepta el mismo origen del sitio.
# Si algun dia se accede desde otros dominios, separarlos por coma:
# SOCKET_ALLOWED_ORIGINS=https://estadio.ejemplo.com,https://panel.ejemplo.com

# Conexion a base de datos MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME_ESTADIO=estadio_db
DB_NAME_SEGURIDAD=seguridad

# Correo SMTP (Gmail con App Password)
# 1. Activar 2FA en tu cuenta Gmail
# 2. Generar App Password en: https://myaccount.google.com/apppasswords
# 3. Copiar el password de 16 caracteres generado
MAIL_USERNAME=tu_correo@gmail.com
MAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_DEFAULT_SENDER=tu_correo@gmail.com
